{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.vue", "tests/**/*.ts"],
  "compilerOptions": {
    "composite": true,
    "outDir": "./node_modules/.tsc-cache/app",
    "tsBuildInfoFile": "./node_modules/.tsc-cache/app.tsbuildinfo",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "verbatimModuleSyntax": true,
    "strict": true,
    "noUncheckedIndexedAccess": true
  }
}
