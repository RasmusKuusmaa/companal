# Copy to .env and fill in real values. Never commit .env.

# --- App ---
APP_NAME=Cadence API
ENVIRONMENT=local
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-random-string-at-least-32-characters-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Database ---
# Used by docker-compose to provision the postgres container
POSTGRES_USER=cadence
POSTGRES_PASSWORD=cadence
POSTGRES_DB=cadence
# Used by the app / Alembic. Must use the asyncpg driver.
DATABASE_URL=postgresql+asyncpg://cadence:cadence@localhost:5432/cadence

# --- CORS ---
# Comma-separated list of allowed origins, e.g. http://localhost:5173
CORS_ORIGINS=http://localhost:5173
